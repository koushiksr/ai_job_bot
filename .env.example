# MongoDB Atlas Connection URI (Required)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_job_bot

# OpenAI (Primary LLM for headline/resume/analyze routes; Groq/OpenRouter stay as fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano-2026-03-17

# Session auth (REQUIRED — no defaults by design)
SESSION_SECRET=
# Super-admin login (replaces any hardcoded bypass; set a strong password)
SUPER_ADMIN_EMAIL=technohmsit@gmail.com
SUPER_ADMIN_PASSWORD=
# Shared secret with the Python worker dispatch hook (must match backend .env WORKER_SECRET)
WORKER_SECRET=
CRON_SECRET=

# Meta (Facebook / Instagram) Pixel & Google Analytics (Optional for Ad Conversion Tracking)
NEXT_PUBLIC_FACEBOOK_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
